{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "label": "npm: watch",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "label": "npm: compile",
      "group": "build"
    },
    {
      "label": "tish-lsp: cargo build (debug)",
      "type": "shell",
      "command": "cargo build -p tishlang_lsp",
      "options": {
        "cwd": "${workspaceFolder}/../tish"
      },
      "problemMatcher": "$rustc",
      "group": "build"
    },
    {
      "label": "extension dev: compile + tish-lsp (debug)",
      "dependsOrder": "parallel",
      "dependsOn": ["npm: compile", "tish-lsp: cargo build (debug)"],
      "problemMatcher": []
    },
    {
      "label": "tish: run current file (example)",
      "type": "shell",
      "command": "tish",
      "args": ["run", "${file}"],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "tish: build native (example)",
      "type": "shell",
      "command": "tish",
      "args": ["build", "${file}", "--output", "${workspaceFolder}/tish_out", "--target", "native"],
      "group": "build",
      "problemMatcher": ["$tish-rustc"]
    },
    {
      "label": "tish-fmt: --check current file",
      "type": "shell",
      "command": "tish-fmt",
      "args": ["--check", "${file}"],
      "problemMatcher": []
    },
    {
      "label": "tish-lint: current file",
      "type": "shell",
      "command": "tish-lint",
      "args": ["${file}"],
      "problemMatcher": []
    }
  ]
}
