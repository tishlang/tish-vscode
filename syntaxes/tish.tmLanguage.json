{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tish",
  "scopeName": "source.tish",
  "patterns": [
    { "include": "#jsx" },
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#template" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#types" }
  ],
  "repository": {
    "jsx": {
      "patterns": [
        {
          "begin": "(<)(/?)([A-Z][a-zA-Z0-9_.-]*)",
          "end": "(/?>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.tsx" },
            "2": { "name": "punctuation.definition.tag.begin.tsx" },
            "3": { "name": "support.class.component.tsx" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.tsx" }
          },
          "name": "meta.tag.tsx",
          "patterns": [
            {
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(=)",
              "captures": {
                "1": { "name": "entity.other.attribute-name.tsx" },
                "2": { "name": "keyword.operator.assignment.tsx" }
              }
            },
            { "include": "#strings" },
            { "include": "#jsx-expr" }
          ]
        },
        {
          "begin": "(<)(/?)([a-zA-Z_][a-zA-Z0-9_.-]*)",
          "end": "(/?>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.tsx" },
            "2": { "name": "punctuation.definition.tag.begin.tsx" },
            "3": { "name": "entity.name.tag.tsx" }
          },
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.tsx" }
          },
          "name": "meta.tag.tsx",
          "patterns": [
            {
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(=)",
              "captures": {
                "1": { "name": "entity.other.attribute-name.tsx" },
                "2": { "name": "keyword.operator.assignment.tsx" }
              }
            },
            { "include": "#strings" },
            { "include": "#jsx-expr" }
          ]
        }
      ]
    },
    "jsx-expr": {
      "patterns": [
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.embedded.expression.tsx",
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.ts", "begin": "//", "end": "$" },
        { "name": "comment.block.ts", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ts",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.ts", "match": "\\\\." }]
        },
        {
          "name": "string.quoted.single.ts",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.ts", "match": "\\\\." }]
        }
      ]
    },
    "template": {
      "patterns": [
        {
          "name": "string.template.ts",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "meta.embedded.line.ts",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(type|interface)\\s+([A-Za-z_$][A-Za-z0-9_$]*)",
          "captures": {
            "1": { "name": "storage.type.ts" },
            "2": { "name": "entity.name.type.ts" }
          }
        },
        { "name": "keyword.control.conditional.ts", "match": "\\b(if|else)\\b" },
        { "name": "keyword.control.loop.ts", "match": "\\b(while|for|do)\\b" },
        {
          "name": "keyword.control.flow.ts",
          "match": "\\b(return|break|continue|throw|await)\\b"
        },
        { "name": "keyword.control.trycatch.ts", "match": "\\b(try|catch|finally)\\b" },
        { "name": "keyword.control.switch.ts", "match": "\\b(switch|case)\\b" },
        { "name": "keyword.control.default.ts", "match": "\\b(default)\\b" },
        { "name": "keyword.control.import.ts", "match": "\\b(import)\\b" },
        { "name": "keyword.control.export.ts", "match": "\\b(export)\\b" },
        { "name": "keyword.control.from.ts", "match": "\\b(from)\\b" },
        { "name": "keyword.control.as.ts", "match": "\\b(as)\\b" },
        { "name": "keyword.control.extends.ts", "match": "\\b(extends)\\b" },
        { "name": "keyword.operator.expression.of.ts", "match": "\\b(of)\\b" },
        { "name": "keyword.operator.expression.in.ts", "match": "\\b(in)\\b" },
        { "name": "keyword.operator.expression.typeof.ts", "match": "\\b(typeof)\\b" },
        { "name": "keyword.operator.expression.void.ts", "match": "\\b(void)\\b" },
        { "name": "keyword.operator.expression.delete.ts", "match": "\\b(delete)\\b" },
        { "name": "keyword.operator.new.ts", "match": "\\b(new)\\b" },
        { "name": "storage.modifier.async.ts", "match": "\\b(async)\\b" },
        { "name": "storage.modifier.declare.ts", "match": "\\b(declare)\\b" },
        { "name": "storage.type.function.ts", "match": "\\b(fn|function)\\b" },
        { "name": "storage.type.ts", "match": "\\b(let|const)\\b" },
        { "name": "constant.language.boolean.true.ts", "match": "\\b(true)\\b" },
        { "name": "constant.language.boolean.false.ts", "match": "\\b(false)\\b" },
        { "name": "constant.language.null.ts", "match": "\\b(null)\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ts",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.ts",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ts",
          "match": "(?<=:)\\s*\\b(number|string|boolean|null|void|any)\\b"
        }
      ]
    }
  }
}
