{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tish",
  "scopeName": "source.tish",
  "patterns": [
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#import-export"
        },
        {
          "include": "#type-alias"
        },
        {
          "include": "#function-declaration"
        },
        {
          "include": "#variable-declaration"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#regex"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#template"
        },
        {
          "include": "#jsx"
        },
        {
          "include": "#function-expression"
        },
        {
          "include": "#arrow-function"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#language-constants"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#new-expression"
        },
        {
          "include": "#property-access"
        },
        {
          "include": "#object-key"
        },
        {
          "include": "#function-call"
        },
        {
          "include": "#type-cast"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#brackets"
        },
        {
          "include": "#punctuation"
        },
        {
          "include": "#identifiers"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.js",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.js"
            }
          },
          "patterns": [
            {
              "match": "(@)(param|returns?|type|typedef|example|deprecated|see|throws|template|todo)\\b",
              "captures": {
                "1": {
                  "name": "punctuation.definition.block.tag.jsdoc"
                },
                "2": {
                  "name": "storage.type.class.jsdoc"
                }
              }
            }
          ]
        },
        {
          "name": "comment.block.js",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.js"
            }
          }
        },
        {
          "name": "comment.line.double-slash.js",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.js"
            }
          },
          "end": "$"
        }
      ]
    },
    "import-export": {
      "patterns": [
        {
          "begin": "\\b(import)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.import.js"
            }
          },
          "end": "(?<=[\"'])|(?=$)",
          "name": "meta.import.js",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "name": "keyword.control.from.js",
              "match": "\\bfrom\\b"
            },
            {
              "name": "keyword.control.as.js",
              "match": "\\bas\\b"
            },
            {
              "name": "keyword.control.default.js",
              "match": "\\bdefault\\b"
            },
            {
              "name": "keyword.operator.type.ts",
              "match": "\\btype\\b"
            },
            {
              "name": "constant.language.import-export-all.js",
              "match": "\\*"
            },
            {
              "name": "punctuation.definition.block.js",
              "match": "[{}]"
            },
            {
              "name": "punctuation.separator.comma.js",
              "match": ","
            },
            {
              "name": "variable.other.readwrite.alias.js",
              "match": "[A-Za-z_$][\\w$]*"
            }
          ]
        },
        {
          "match": "\\b(export)\\s+(default)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.export.js"
            },
            "2": {
              "name": "keyword.control.default.js"
            }
          }
        },
        {
          "begin": "\\b(export)\\s*(?=\\{|\\*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.export.js"
            }
          },
          "end": "(?<=[\"'}])(?!\\s*from)|(?=$)",
          "name": "meta.export.js",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "name": "keyword.control.from.js",
              "match": "\\bfrom\\b"
            },
            {
              "name": "keyword.control.as.js",
              "match": "\\bas\\b"
            },
            {
              "name": "constant.language.import-export-all.js",
              "match": "\\*"
            },
            {
              "name": "punctuation.definition.block.js",
              "match": "[{}]"
            },
            {
              "name": "punctuation.separator.comma.js",
              "match": ","
            },
            {
              "name": "variable.other.readwrite.alias.js",
              "match": "[A-Za-z_$][\\w$]*"
            }
          ]
        },
        {
          "name": "keyword.control.export.js",
          "match": "\\b(export)\\b"
        }
      ]
    },
    "type-alias": {
      "begin": "\\b(declare\\s+)?(type|interface)\\s+([A-Za-z_$][\\w$]*)",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.declare.ts"
        },
        "2": {
          "name": "storage.type.js"
        },
        "3": {
          "name": "entity.name.type.alias.ts"
        }
      },
      "end": "(?<=\\})|(?<![=|&,<\\s])\\s*$",
      "name": "meta.type.declaration.ts",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "name": "keyword.operator.assignment.js",
          "match": "="
        },
        {
          "name": "storage.modifier.js",
          "match": "\\bextends\\b"
        },
        {
          "include": "#type"
        }
      ]
    },
    "type": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "name": "support.type.primitive.ts",
          "match": "\\b(number|string|boolean|null|void|any|never|unknown|object|symbol|bigint|undefined)\\b"
        },
        {
          "name": "constant.language.boolean.js",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.numeric.decimal.js",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        },
        {
          "name": "keyword.operator.expression.typeof.js",
          "match": "\\b(typeof|keyof)\\b"
        },
        {
          "name": "keyword.operator.type.ts",
          "match": "[|&]"
        },
        {
          "name": "keyword.operator.type.annotation.ts",
          "match": ":"
        },
        {
          "name": "keyword.operator.optional.ts",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.type.ts",
          "match": "=>"
        },
        {
          "begin": "<",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.begin.ts"
            }
          },
          "end": ">",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.ts"
            }
          },
          "name": "meta.type.parameters.ts",
          "patterns": [
            {
              "include": "#type"
            },
            {
              "name": "punctuation.separator.comma.js",
              "match": ","
            }
          ]
        },
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.block.js"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.block.js"
            }
          },
          "name": "meta.object.type.ts",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "([A-Za-z_$][\\w$]*)\\s*(\\?)?\\s*(?=:)",
              "captures": {
                "1": {
                  "name": "variable.object.property.ts"
                },
                "2": {
                  "name": "keyword.operator.optional.ts"
                }
              }
            },
            {
              "include": "#type"
            },
            {
              "name": "punctuation.separator.comma.js",
              "match": "[,;]"
            }
          ]
        },
        {
          "begin": "\\(",
          "beginCaptures": {
            "0": {
              "name": "meta.brace.round.js"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "meta.brace.round.js"
            }
          },
          "patterns": [
            {
              "match": "([A-Za-z_$][\\w$]*)\\s*(\\?)?\\s*(?=:)",
              "captures": {
                "1": {
                  "name": "variable.parameter.js"
                },
                "2": {
                  "name": "keyword.operator.optional.ts"
                }
              }
            },
            {
              "include": "#type"
            },
            {
              "name": "punctuation.separator.comma.js",
              "match": ","
            }
          ]
        },
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "meta.brace.square.js"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "meta.brace.square.js"
            }
          },
          "patterns": [
            {
              "include": "#type"
            },
            {
              "name": "punctuation.separator.comma.js",
              "match": ","
            }
          ]
        },
        {
          "name": "entity.name.type.ts",
          "match": "[A-Za-z_$][\\w$]*(\\.[A-Za-z_$][\\w$]*)*"
        }
      ]
    },
    "type-annotation": {
      "begin": "(?<![?:]):(?!:)",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.type.annotation.ts"
        }
      },
      "end": "(?=[=,;)\\]}]|$)|(?<=[A-Za-z0-9_$>\\]})])(?=\\s*(?:[,;)=}\\]]|$))",
      "name": "meta.type.annotation.ts",
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "return-type": {
      "begin": "(?<=\\))\\s*(:)",
      "beginCaptures": {
        "1": {
          "name": "keyword.operator.type.annotation.ts"
        }
      },
      "end": "(?=\\{|=>|$)",
      "name": "meta.return.type.ts",
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "type-cast": {
      "match": "\\b(as)\\s+([A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*|\"[^\"]*\"|'[^']*')",
      "captures": {
        "1": {
          "name": "keyword.control.as.js"
        },
        "2": {
          "name": "entity.name.type.ts"
        }
      }
    },
    "parameters": {
      "begin": "\\(",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.begin.js"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.parameters.end.js"
        }
      },
      "name": "meta.parameters.js",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type-annotation"
        },
        {
          "name": "keyword.operator.rest.js",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.optional.ts",
          "match": "\\?(?=\\s*:)"
        },
        {
          "begin": "=",
          "beginCaptures": {
            "0": {
              "name": "keyword.operator.assignment.js"
            }
          },
          "end": "(?=[,)])",
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "name": "punctuation.definition.binding-pattern.object.js",
          "match": "[{}]"
        },
        {
          "name": "punctuation.definition.binding-pattern.array.js",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.separator.comma.js",
          "match": ","
        },
        {
          "name": "variable.parameter.js",
          "match": "[A-Za-z_$][\\w$]*"
        }
      ]
    },
    "function-declaration": {
      "begin": "\\b(?:(export)\\s+)?(?:(async)\\s+)?(fn|function)\\s*(\\*)?\\s*([A-Za-z_$][\\w$]*)?\\s*(?=\\(|<)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.export.js"
        },
        "2": {
          "name": "storage.modifier.async.js"
        },
        "3": {
          "name": "storage.type.function.js"
        },
        "4": {
          "name": "keyword.generator.asterisk.js"
        },
        "5": {
          "name": "entity.name.function.js"
        }
      },
      "end": "(?<=\\))(?=\\s*(?:\\{|$))|(?=\\{)|(?<=\\))\\s*$",
      "name": "meta.function.js",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "begin": "<",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.begin.ts"
            }
          },
          "end": ">",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.typeparameters.end.ts"
            }
          },
          "patterns": [
            {
              "include": "#type"
            },
            {
              "name": "punctuation.separator.comma.js",
              "match": ","
            }
          ]
        },
        {
          "include": "#parameters"
        },
        {
          "include": "#return-type"
        }
      ]
    },
    "function-expression": {
      "begin": "\\b(?:(async)\\s+)?(fn|function)\\s*(\\*)?\\s*([A-Za-z_$][\\w$]*)?\\s*(?=\\()",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.async.js"
        },
        "2": {
          "name": "storage.type.function.js"
        },
        "3": {
          "name": "keyword.generator.asterisk.js"
        },
        "4": {
          "name": "entity.name.function.js"
        }
      },
      "end": "(?<=\\))(?=\\s*(?:\\{|$))|(?=\\{)",
      "name": "meta.function.expression.js",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#parameters"
        },
        {
          "include": "#return-type"
        }
      ]
    },
    "arrow-function": {
      "patterns": [
        {
          "match": "\\b(?:(async)\\s+)?([A-Za-z_$][\\w$]*)\\s*(=>)",
          "captures": {
            "1": {
              "name": "storage.modifier.async.js"
            },
            "2": {
              "name": "variable.parameter.js"
            },
            "3": {
              "name": "storage.type.function.arrow.js"
            }
          }
        },
        {
          "begin": "(?:\\b(async)\\s+)?(?=\\([^()]*\\)\\s*(?::[^=]*)?=>)",
          "beginCaptures": {
            "1": {
              "name": "storage.modifier.async.js"
            }
          },
          "end": "(=>)",
          "endCaptures": {
            "1": {
              "name": "storage.type.function.arrow.js"
            }
          },
          "name": "meta.arrow.js",
          "patterns": [
            {
              "include": "#parameters"
            },
            {
              "include": "#return-type"
            }
          ]
        }
      ]
    },
    "variable-declaration": {
      "begin": "\\b(?:(export)\\s+)?(?:(declare)\\s+)?(let|const)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.export.js"
        },
        "2": {
          "name": "storage.modifier.declare.ts"
        },
        "3": {
          "name": "storage.type.js"
        }
      },
      "end": "(?=[=;]|\\bin\\b|\\bof\\b|$)",
      "name": "meta.var.expr.js",
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type-annotation"
        },
        {
          "match": "([A-Za-z_$][\\w$]*)(?=\\s*=\\s*(?:async\\s+)?(?:fn\\b|function\\b|\\([^()]*\\)\\s*(?::[^=]*)?=>|[A-Za-z_$][\\w$]*\\s*=>))",
          "captures": {
            "1": {
              "name": "entity.name.function.js"
            }
          }
        },
        {
          "match": "(?<=\\bconst\\s)\\s*([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": {
              "name": "variable.other.constant.js"
            }
          }
        },
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.binding-pattern.object.js"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.binding-pattern.object.js"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "keyword.operator.rest.js",
              "match": "\\.\\.\\."
            },
            {
              "name": "punctuation.separator.comma.js",
              "match": ","
            },
            {
              "name": "punctuation.destructuring.js",
              "match": ":"
            },
            {
              "name": "variable.other.readwrite.js",
              "match": "[A-Za-z_$][\\w$]*"
            }
          ]
        },
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.binding-pattern.array.js"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.binding-pattern.array.js"
            }
          },
          "patterns": [
            {
              "name": "keyword.operator.rest.js",
              "match": "\\.\\.\\."
            },
            {
              "name": "punctuation.separator.comma.js",
              "match": ","
            },
            {
              "name": "variable.other.readwrite.js",
              "match": "[A-Za-z_$][\\w$]*"
            }
          ]
        },
        {
          "name": "punctuation.separator.comma.js",
          "match": ","
        },
        {
          "name": "variable.other.constant.js",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        },
        {
          "name": "variable.other.readwrite.js",
          "match": "[A-Za-z_$][\\w$]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.js",
          "match": "\\b(if|else)\\b"
        },
        {
          "name": "keyword.control.loop.js",
          "match": "\\b(while|for|do)\\b"
        },
        {
          "name": "keyword.control.flow.js",
          "match": "\\b(return|break|continue|throw|await|yield)\\b"
        },
        {
          "name": "keyword.control.trycatch.js",
          "match": "\\b(try|catch|finally)\\b"
        },
        {
          "name": "keyword.control.switch.js",
          "match": "\\b(switch|case)\\b"
        },
        {
          "name": "keyword.control.default.js",
          "match": "\\b(default)\\b"
        },
        {
          "name": "keyword.control.import.js",
          "match": "\\b(import)\\b"
        },
        {
          "name": "keyword.control.export.js",
          "match": "\\b(export)\\b"
        },
        {
          "name": "keyword.control.from.js",
          "match": "\\b(from)\\b"
        },
        {
          "name": "keyword.control.as.js",
          "match": "\\b(as)\\b"
        },
        {
          "name": "storage.modifier.js",
          "match": "\\b(extends|implements|static|readonly)\\b"
        },
        {
          "name": "keyword.operator.expression.of.js",
          "match": "\\b(of)\\b"
        },
        {
          "name": "keyword.operator.expression.in.js",
          "match": "\\b(in|instanceof)\\b"
        },
        {
          "name": "keyword.operator.expression.typeof.js",
          "match": "\\b(typeof|keyof)\\b"
        },
        {
          "name": "keyword.operator.expression.void.js",
          "match": "\\b(void)\\b"
        },
        {
          "name": "keyword.operator.expression.delete.js",
          "match": "\\b(delete)\\b"
        },
        {
          "name": "storage.modifier.async.js",
          "match": "\\b(async)\\b"
        },
        {
          "name": "storage.modifier.declare.ts",
          "match": "\\b(declare)\\b"
        },
        {
          "name": "storage.type.function.js",
          "match": "\\b(fn|function)\\b"
        },
        {
          "name": "storage.type.js",
          "match": "\\b(let|const|type|interface)\\b"
        },
        {
          "name": "storage.type.class.js",
          "match": "\\b(class|enum)\\b"
        }
      ]
    },
    "language-constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.true.js",
          "match": "\\b(true)\\b"
        },
        {
          "name": "constant.language.boolean.false.js",
          "match": "\\b(false)\\b"
        },
        {
          "name": "constant.language.null.js",
          "match": "\\b(null)\\b"
        },
        {
          "name": "constant.language.undefined.js",
          "match": "\\b(undefined)\\b"
        },
        {
          "name": "constant.language.nan.js",
          "match": "\\b(NaN)\\b"
        },
        {
          "name": "constant.language.infinity.js",
          "match": "\\b(Infinity)\\b"
        },
        {
          "name": "variable.language.this.js",
          "match": "\\b(this)\\b"
        },
        {
          "name": "variable.language.super.js",
          "match": "\\b(super)\\b"
        },
        {
          "name": "variable.language.arguments.js",
          "match": "\\b(arguments)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.js",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.js",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.octal.js",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.js",
          "match": "(?<![\\w$])(?:\\d[\\d_]*\\.?[\\d_]*|\\.\\d[\\d_]*)(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
