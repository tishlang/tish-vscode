{
  "name": "tish-extension",
  "displayName": "Tish",
  "description": "Language support for Tish (including JSX in .tish) — syntax highlighting, snippets, tasks; language server",
  "version": "0.1.0",
  "tishLsp": {
    "downloadRepo": "tishlang/tish",
    "releaseTag": "v0.1.1"
  },
  "publisher": "tish",
  "license": "PIF",
  "repository": {
    "type": "git",
    "url": "https://github.com/tishlang/tish-vscode"
  },
  "homepage": "https://tishlang.com",
  "bugs": {
    "url": "https://github.com/tishlang/tish-vscode/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "tish",
    "tish",
    "javascript",
    "native"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, workspace-defined language-server download settings are ignored. Syntax highlighting and a locally configured tish-lsp (user settings, PATH, or TISH_LANGUAGE_SERVER_PATH) still work; trust the workspace to allow workspace download overrides.",
      "restrictedConfigurations": [
        "tish.languageServerDownload.enable",
        "tish.languageServerDownload.url",
        "tish.languageServerDownload.repo",
        "tish.languageServerDownload.releaseTag"
      ]
    }
  },
  "activationEvents": [
    "onLanguage:tish",
    "onCommand:tish.showLanguageServerOutput",
    "onCommand:tish.showExtensionOutput",
    "onCommand:tish.toggleExtensionDebug",
    "workspaceContains:**/*.tish",
    "workspaceContains:**/*.tishx"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tish.showLanguageServerOutput",
        "title": "Show Language Server Output",
        "category": "Tish"
      },
      {
        "command": "tish.showExtensionOutput",
        "title": "Show Extension Output",
        "category": "Tish"
      },
      {
        "command": "tish.toggleExtensionDebug",
        "title": "Toggle Extension Debug Logging",
        "category": "Tish"
      }
    ],
    "languages": [
      {
        "id": "tish",
        "aliases": [
          "Tish",
          "tish"
        ],
        "extensions": [
          ".tish",
          ".tishx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tish",
        "scopeName": "source.tish",
        "path": "./syntaxes/tish.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "tish",
        "path": "./snippets/tish.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "tish-compile",
        "owner": "tish",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      },
      {
        "name": "tish-rustc",
        "owner": "rustc",
        "source": "rustc",
        "fileLocation": "autoDetect",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning)(\\[E\\d+\\])?:\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 6
        }
      }
    ],
    "configuration": {
      "title": "Tish",
      "properties": {
        "tish.debug.extension": {
          "type": "boolean",
          "default": false,
          "description": "Log extension-side lifecycle and tish-lsp resolution to Output → “Tish Extension” with [tish-ext ISO8601 …] prefixes (boot lines always appear there). “Tish Language Server” is for the server process, downloads, and tish.trace.server. Toggle: “Tish: Toggle Extension Debug Logging”."
        },
        "tish.languageServerPath": {
          "type": "string",
          "default": "",
          "description": "Path to tish-lsp executable. Overrides TISH_LANGUAGE_SERVER_PATH, dev sibling lookup, download, and PATH."
        },
        "tish.languageServerDownload.enable": {
          "type": "boolean",
          "default": true,
          "description": "Download tish-lsp from GitHub Releases on first use (cached under global storage)."
        },
        "tish.languageServerDownload.repo": {
          "type": "string",
          "default": "",
          "description": "GitHub repo owner/name for binaries (default: value from extension package.json tishLsp.downloadRepo)."
        },
        "tish.languageServerDownload.releaseTag": {
          "type": "string",
          "default": "",
          "description": "Release tag to download (default: package.json tishLsp.releaseTag)."
        },
        "tish.languageServerDownload.url": {
          "type": "string",
          "default": "",
          "description": "Full URL to tish-lsp binary (overrides repo/tag asset lookup)."
        },
        "tish.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP communication (Output → Tish Language Server)."
        },
        "tish.format.enable": {
          "type": "boolean",
          "default": false,
          "description": "Format document on save via tish-lsp. Off by default: the formatter re-emits the AST and does not preserve comments; JSX is re-laid out (may differ from your style). Turn on only when you want normalized output."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package:vsix": "npx --yes @vscode/vsce@3 package --out tish.vsix"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
